# ==========================================
# API Key Rotator - Environment Configuration Example
# ==========================================
#
# Current Architecture: Runtime Auto-Detection + Interface Abstraction
# System automatically selects database and cache type based on environment variables
#
# === Lightweight Mode (Default) ===
# No database/cache variables set, system will automatically use:
# - Database: SQLite (file: /app/data/api_key_rotator.db)
# - Cache: Memory Cache
#
# === Enterprise Mode ===
# Set the following variables to automatically switch to MySQL + Redis:
# - DB_HOST, DB_USER, DB_PASSWORD, etc. -> Switch to MySQL
# - REDIS_HOST, REDIS_PORT, etc. -> Switch to Redis

# === Database Configuration ===
# SQLite (default, no additional configuration needed)
DATABASE_PATH=/app/data/api_key_rotator.db

# MySQL (optional, automatically enabled when setting these variables)
# Method 1: Use connection string
# DATABASE_URL=mysql://user:password@tcp(host:port)/database?charset=utf8mb4&parseTime=True&loc=Local

# Method 2: Use separate configuration variables
DB_HOST=localhost
DB_USER=appdb
DB_PASSWORD=your_strong_password
DB_NAME=api_key_rotator
DB_PORT=3306

# === Cache Configuration ===
# Memory Cache (default, no additional configuration needed)

# Redis (optional, automatically enabled when setting these variables)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# === Server Configuration ===
BACKEND_PORT=8000

# === Authentication Configuration ===
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_admin_password_here
JWT_SECRET=your_very_secret_and_random_jwt_key

# === Proxy Configuration ===
# Global proxy authentication key (supports single or multiple, comma-separated)
GLOBAL_PROXY_KEYS=your_secure_global_proxy_key

# Proxy timeout setting (seconds)
PROXY_TIMEOUT=30

# === API Key Rotation / Rate Limit (429) Handling ===
# How long a key stays "cooling down" after the upstream answers 429.
# While a key cools down, other healthy keys are used first, so a rate limited
# key is not hit again on every single request.
# If the upstream sends a Retry-After header (or a Gemini "retryDelay" in the
# error body), that value wins over this default.
# Set to 0 to disable cooldown (plain round-robin + switch key on failure).
KEY_COOLDOWN_SECONDS=60

# Upper bound for a single cooldown (seconds), so an upstream asking for a very
# long Retry-After cannot park a key forever.
KEY_MAX_COOLDOWN_SECONDS=1800

# User-Agent sent to upstream APIs when the client does not send one.
# The Go default ("Go-http-client/1.1") is blocked by many WAFs/CDNs with a 403
# before the request ever reaches the model. Leave empty to keep the Go default.
UPSTREAM_USER_AGENT="Mozilla/5.0 (compatible; APIKeyRotator/1.0; +https://github.com/arvindg4u/APIKeyRotator)"

# When the upstream answers with a WAF/CDN block page (403/401 with a non-JSON
# body), the proxy retries the same key once with this User-Agent. The block is
# a request-fingerprint problem (usually the client's own User-Agent), so
# switching keys cannot help. Set it to empty to disable the retry.
WAF_RETRY_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/125.0.0.0 Safari/537.36"

# Set to false to turn the block-page retry off entirely.
UPSTREAM_WAF_RETRY=true

# Public base URL for proxy service
PROXY_PUBLIC_BASE_URL=http://localhost:8000

# === Logging Configuration ===
LOG_LEVEL=info

# === Docker Deployment Related ===
MYSQL_ROOT_PASSWORD=a_very_strong_root_password

# === Database Reset Option ===
# If set to true, all tables will be dropped and recreated
RESET_DB_TABLES=false