# Render-optimized build - lightweight (SQLite + memory cache)
# Same app as the root Dockerfile, tuned for Render:
# - default Go module proxy (not China-only mirror)
# - SQLite path defaults to the Render disk mount (/var/data)
# - listens on Render's injected $PORT (see config.getServerPort)

# ---- Stage 1: Build Backend ----
FROM golang:1.22 AS backend-builder
WORKDIR /app/backend

COPY backend/go.mod backend/go.sum ./
RUN go mod download

COPY backend/internal ./internal
COPY backend/main.go .

RUN CGO_ENABLED=1 GOOS=linux go build \
    -ldflags="-s -w -extldflags '-static'" \
    -o ./api-key-rotator .

# ---- Stage 2: Build Frontend ----
FROM node:22-alpine AS frontend-builder
WORKDIR /app/frontend

RUN npm install -g pnpm

COPY frontend/package.json frontend/pnpm-lock.yaml* ./
RUN pnpm install

COPY frontend/ ./
RUN pnpm run build

# ---- Stage 3: Final Image ----
FROM alpine:3.22.0

RUN apk add --no-cache ca-certificates tzdata sqlite

WORKDIR /app

COPY --from=backend-builder /app/backend/api-key-rotator ./
COPY --from=frontend-builder /app/frontend/dist ./static

RUN mkdir -p /app/data /var/data && chmod +x ./api-key-rotator

EXPOSE 10000

ENV DB_TYPE=sqlite \
    CACHE_TYPE=memory \
    DATABASE_PATH=/var/data/api_key_rotator.db \
    LOG_LEVEL=info

# 健康检查
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:${PORT:-10000}/health || exit 1

CMD ["./api-key-rotator"]
